# Copie este arquivo para `.env` (no mesmo diretório backend/) e preencha.
# O .env NÃO vai para o git (está no .gitignore) — a senha fica só na sua máquina.

# Connection string do Postgres do Supabase.
# Supabase: Settings -> Database -> Connection string -> URI. Cole aqui.
# Troque [YOUR-PASSWORD] pela senha do banco que você definiu ao criar o projeto.
# Ex.: postgresql://postgres:SUA_SENHA@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# Sem DATABASE_URL, o backend roda com dados em memória (mesmo comportamento do passo 1).

# --- LLM (passo 4): recomendações e chat gerados por IA ---
# Sem LLM_API_KEY, o backend usa os textos prontos (fallback) — nada quebra.
# Groq (grátis): crie a chave em https://console.groq.com -> API Keys.
LLM_API_KEY=
# Padrões para o Groq (compatível com a API da OpenAI). Para Gemini/outro, troque os dois.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

