# Copie este arquivo para `.env` (no mesmo diretório backend/) e preencha.
# O .env NÃO vai para o git (está no .gitignore) — a senha fica só na sua máquina.

# Banco de dados. Escolha UMA opção:
#
# 1) SQLite (recomendado para apresentar): um arquivo em backend/trilha.db, sem servidor
#    e sem internet. Funciona em redes que bloqueiam a porta do Postgres. Se o arquivo
#    não existir, a API cria e popula a demo sozinha ao subir.
DATABASE_URL=sqlite:///trilha.db
#
# 2) Postgres do Supabase: Settings -> Database -> Connection string -> URI.
#    Troque [YOUR-PASSWORD] pela senha do banco. Depois rode: python -m app.seed
# DATABASE_URL=postgresql://postgres:SUA_SENHA@db.xxxxxxxx.supabase.co:5432/postgres
#
# Sem DATABASE_URL, o backend roda com dados em memória (perde tudo ao reiniciar).

# --- LLM (passo 4): recomendações e chat gerados por IA ---
# Sem LLM_API_KEY, o backend usa os textos prontos (fallback) — nada quebra.
# Groq (grátis): crie a chave em https://console.groq.com -> API Keys.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low

# Revisor independente das questões geradas por IA. Na Groq o limite grátis é POR MODELO:
# usar outro modelo aqui dá ao revisor uma cota própria (e uma "segunda opinião" de verdade).
# Usa a mesma chave/URL de cima, a menos que você defina LLM_REVISOR_API_KEY/_BASE_URL.
LLM_REVISOR_MODEL=qwen/qwen3.8-27b

# Opcional: provedor de reserva, também grátis, usado quando a cota do dia acaba.
# Ex.: Gemini — crie a chave (sem cartão) em https://aistudio.google.com/apikey
#LLM_RESERVA_API_KEY=
#LLM_RESERVA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_RESERVA_MODEL=gemini-2.5-flash
