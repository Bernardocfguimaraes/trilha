# API do backend (Python). Sem esta variável o frontend usa respostas de exemplo (src/lib/mock.ts).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# O login do professor é conferido pelo backend (PROFESSOR_EMAIL / PROFESSOR_SENHA em backend/.env).
# Só sem backend (modo mock) o front usa as variáveis abaixo, no servidor, para o login de exemplo.
# PROFESSOR_EMAIL=professora@trilha.app
# PROFESSOR_SENHA=trilha-demo
